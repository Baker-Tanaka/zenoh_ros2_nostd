{
    "version": "0.2.0",
    "configurations": [
        {
            "preLaunchTask": "rust: cargo build",
            "type": "probe-rs-debug",
            "request": "launch",
            "name": "probe_rs Server attach example",
            "server": "host.docker.internal:50001",
            "speed": 4000,
            "chip": "RP2040",
            "flashingConfig": {
                "flashingEnabled": true,
                "haltAfterReset": true,
            },
            "coreConfigs": [
                {
                    "coreIndex": 0,
                    "programBinary": "${env:LOCAL_WORKSPACE_FOLDER}/target/thumbv6m-none-eabi/debug/zenoh_ros2_nostd",
                    "rttEnabled": true,
                }
            ],
            "env": {
                "RUST_LOG": "info"
            },
            "consoleLogLevel": "Info"
        },
        {
            "preLaunchTask": "esp32c3: build (release)",
            "type": "probe-rs-debug",
            "request": "launch",
            "name": "ESP32-C3 Wi-Fi demo",
            "server": "host.docker.internal:50001",
            "chip": "esp32c3",
            "flashingConfig": {
                "flashingEnabled": true,
                "haltAfterReset": false,
            },
            "coreConfigs": [
                {
                    "coreIndex": 0,
                    "programBinary": "${env:LOCAL_WORKSPACE_FOLDER}/examples/esp32c3_wifi/target/riscv32imc-unknown-none-elf/release/esp32c3-wifi",
                    "rttEnabled": true,
                    "rttChannelFormats": [
                        {
                            "channelNumber": 0,
                            "dataFormat": "String",
                            "showTimestamps": true,
                        }
                    ],
                }
            ],
            "consoleLogLevel": "Debug"
        },
        {
            "preLaunchTask": "bakerlink-wiz630io: build (debug)",
            "type": "probe-rs-debug",
            "request": "launch",
            "name": "Baker link. Dev + WIZ630io demo",
            "server": "host.docker.internal:50001",
            "speed": 4000,
            "chip": "RP2040",
            "flashingConfig": {
                "flashingEnabled": true,
                "haltAfterReset": true,
            },
            "coreConfigs": [
                {
                    "coreIndex": 0,
                    "programBinary": "${env:LOCAL_WORKSPACE_FOLDER}/examples/bakerlink_wiz630io/target/thumbv6m-none-eabi/debug/bakerlink-wiz630io",
                    "rttEnabled": true,
                    "rttChannelFormats": [
                        {
                            "channelNumber": 0,
                            "dataFormat": "Defmt",
                            "showTimestamps": true,
                            "showLocation": true,
                        }
                    ],
                }
            ],
            // "pathMappings": [
            //     {
            //         "remoteRoot": "{{project-name}}",
            //         "localRoot": "${env:LOCAL_WORKSPACE_FOLDER}"
            //     }
            // ],
            "consoleLogLevel": "Info"
        }
    ]
}